# --- Database ---
# Lokalt: docker compose (se docker-compose.yml).
# Produksjon: Neon. DATABASE_URL = "pooled" tilkobling (host slutter pa -pooler),
# DIRECT_URL = direkte tilkobling (brukes kun av prisma migrate/db).
DATABASE_URL="postgresql://artkl:artkl@localhost:5432/artkl?schema=public"
DIRECT_URL="postgresql://artkl:artkl@localhost:5432/artkl?schema=public"

PORT=3000

# --- AI ---
# Kreves for /api/rapporter/sporsmal, /api/fakturaer/tolk, /api/varianter/gjenkjenn.
# Uten nokkel svarer disse endepunktene 503.
ANTHROPIC_API_KEY=

# --- Auth ---
# Signeringsnokkel for JWT. Lang tilfeldig streng i produksjon.
JWT_HEMMELIGHET=bytt-meg-lokalt
# Forste admin-bruker opprettes ved oppstart hvis den ikke finnes.
ADMIN_EPOST=admin@example.com
ADMIN_PASSORD=bytt-meg-lokalt

# --- Klient / CORS ---
# Klientens origin. Tom lokalt = tillat alle. I produksjon: https://<vercel-domene>
KLIENT_URL=

# --- Bildelagring (Vercel Blob) ---
# Tom lokalt = /api/bilder svarer 503 (kan fortsatt lime inn bilde-URL manuelt).
BLOB_READ_WRITE_TOKEN=
