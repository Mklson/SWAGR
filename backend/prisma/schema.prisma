generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direkte tilkobling (ikke via pooler) - kun brukt av prisma migrate/db.
  // Lokalt og i test settes den lik DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum ReservasjonStatus {
  aktiv
  kansellert
  fullfort
}

enum BevegelseType {
  inn
  ut
  svinn
  retur
  internbruk
}

enum KontekstType {
  kunde
  prosjekt
  internbruk
  svinn
  retur
  innkjop
}

// En bedrift (tenant). All forretningsdata er scopet til én bedrift; en
// bruker kan være medlem av flere via BrukerBedrift.
model Bedrift {
  id        String   @id @default(uuid())
  navn      String   @unique
  logoUrl   String?  @map("logo_url")
  opprettet DateTime @default(now())

  medlemmer     BrukerBedrift[]
  leverandorer  Leverandor[]
  varer         Vare[]
  varianter     Variant[]
  merker        Merke[]
  lokasjoner    Lokasjon[]
  kontekster    Kontekst[]
  formaal       Formaal[]
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]
  inviterte     InvitertEpost[]

  @@map("bedrifter")
}

// Medlemskap bruker <-> bedrift, med rolle per bedrift.
model BrukerBedrift {
  brukerId  String   @map("bruker_id")
  bedriftId String   @map("bedrift_id")
  rolle     String   @default("ansatt")
  opprettet DateTime @default(now())

  bruker  Bruker  @relation(fields: [brukerId], references: [id], onDelete: Cascade)
  bedrift Bedrift @relation(fields: [bedriftId], references: [id], onDelete: Cascade)

  @@id([brukerId, bedriftId])
  @@map("bruker_bedrift")
}

model Leverandor {
  id        String @id @default(uuid())
  navn      String
  bedriftId String @map("bedrift_id")

  bedrift Bedrift @relation(fields: [bedriftId], references: [id])
  varer   Vare[]

  @@index([bedriftId])
  @@map("leverandorer")
}

model Vare {
  id           String @id @default(uuid())
  navn         String
  kategori     String
  leverandorId String @map("leverandor_id")
  bedriftId    String @map("bedrift_id")

  bedrift    Bedrift    @relation(fields: [bedriftId], references: [id])
  leverandor Leverandor @relation(fields: [leverandorId], references: [id])
  varianter  Variant[]

  @@index([bedriftId])
  @@map("varer")
}

// Egen tabell (ikke fritekst) slik at et merke kan ha én logo og ikke splittes
// opp av skrivevarianter ("Acme Events" vs "acme events").
model Merke {
  id        String  @id @default(uuid())
  navn      String
  logoUrl   String? @map("logo_url")
  bedriftId String  @map("bedrift_id")

  bedrift   Bedrift   @relation(fields: [bedriftId], references: [id])
  varianter Variant[]

  @@unique([bedriftId, navn])
  @@map("merker")
}

model Variant {
  id          String  @id @default(uuid())
  vareId      String  @map("vare_id")
  attributter Json    @default("{}")
  sku         String
  bildeurl    String?
  merkeId     String? @map("merke_id")
  bedriftId   String  @map("bedrift_id")
  // Pris per enhet i øre (heltall) - unngår flyttall-avrundingsfeil på beløp.
  // Nullbar: eksisterende varianter mangler pris til de er satt manuelt.
  verdiOre    Int?    @map("verdi_ore")

  bedrift       Bedrift       @relation(fields: [bedriftId], references: [id])
  vare          Vare          @relation(fields: [vareId], references: [id])
  merke         Merke?        @relation(fields: [merkeId], references: [id])
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]

  @@unique([bedriftId, sku])
  @@index([vareId])
  @@index([merkeId])
  @@index([bedriftId])
  @@map("varianter")
}

model Lokasjon {
  id        String @id @default(uuid())
  navn      String
  type      String
  bedriftId String @map("bedrift_id")

  bedrift       Bedrift       @relation(fields: [bedriftId], references: [id])
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]

  @@index([bedriftId])
  @@map("lokasjoner")
}

model Kontekst {
  id        String       @id @default(uuid())
  type      KontekstType
  navn      String
  referanse String?
  bedriftId String       @map("bedrift_id")

  bedrift       Bedrift       @relation(fields: [bedriftId], references: [id])
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]

  @@index([bedriftId])
  @@map("kontekster")
}

// Enkelt formål for et uttak - "Festival", "Messe", "Gave" osv. Bare et navn.
model Formaal {
  id        String   @id @default(uuid())
  navn      String
  bedriftId String   @map("bedrift_id")
  opprettet DateTime @default(now())

  bedrift       Bedrift       @relation(fields: [bedriftId], references: [id])
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]

  @@unique([bedriftId, navn])
  @@map("formaal")
}

model Bruker {
  id   String @id @default(uuid())
  navn String

  // Innlogging. Nullbare fordi seed/referanse-brukere ikke har paalogging -
  // kun brukere med bade epost og passordHash kan logge inn. Rolle ligger
  // per bedrift i BrukerBedrift.
  epost       String? @unique
  passordHash String? @map("passord_hash")

  // Global administrator: admin i alle bedrifter (nåværende og fremtidige),
  // uavhengig av BrukerBedrift-rollen. Kun for systemeier-kontoen.
  superadmin Boolean @default(false)

  bedrifter     BrukerBedrift[]
  bevegelser    Bevegelse[]
  reservasjoner Reservasjon[]

  @@map("brukere")
}

// Tillatsliste for selvregistrering til en bedrift: en e-post maa vaere
// invitert (av en admin i den bedriften) for /api/auth/registrer godtar den.
model InvitertEpost {
  id        String   @id @default(uuid())
  epost     String
  rolle     String   @default("ansatt")
  bedriftId String   @map("bedrift_id")
  brukt     Boolean  @default(false)
  opprettet DateTime @default(now())

  bedrift Bedrift @relation(fields: [bedriftId], references: [id])

  @@unique([bedriftId, epost])
  @@map("inviterte_eposter")
}

model Bevegelse {
  id         String        @id @default(uuid())
  variantId  String        @map("variant_id")
  lokasjonId String        @map("lokasjon_id")
  bedriftId  String        @map("bedrift_id")
  // Nullbar: kunde er valgfritt på uttak (kan gå til et rent formål uten kunde),
  // og varemottak/svinn/internbruk bruker skjulte system-kontekster.
  kontekstId String?       @map("kontekst_id")
  formaalId  String?       @map("formaal_id")
  brukerId   String        @map("bruker_id")
  type       BevegelseType
  antall     Int
  // Kopi av Variant.verdiOre på registreringstidspunktet, ikke en referanse -
  // en senere prisendring skal ikke endre hva historiske rapporter viser.
  verdiOre   Int?          @map("verdi_ore")
  tidspunkt  DateTime      @default(now())

  bedrift  Bedrift   @relation(fields: [bedriftId], references: [id])
  variant  Variant   @relation(fields: [variantId], references: [id])
  lokasjon Lokasjon  @relation(fields: [lokasjonId], references: [id])
  kontekst Kontekst? @relation(fields: [kontekstId], references: [id])
  formaal  Formaal?  @relation(fields: [formaalId], references: [id])
  bruker   Bruker    @relation(fields: [brukerId], references: [id])

  @@index([variantId, lokasjonId, tidspunkt])
  @@index([bedriftId])
  @@map("bevegelser")
}

// Blokkerer beholdning for annen bruk uten at varen fysisk har flyttet seg.
// Status "aktiv" teller mot tilgjengelig beholdning fra opprettelse til den
// avsluttes manuelt (kansellert/fullfort) - tilDato er kun informativ.
model Reservasjon {
  id         String            @id @default(uuid())
  variantId  String            @map("variant_id")
  lokasjonId String            @map("lokasjon_id")
  bedriftId  String            @map("bedrift_id")
  kontekstId String?           @map("kontekst_id")
  formaalId  String?           @map("formaal_id")
  brukerId   String            @map("bruker_id")
  antall     Int
  status     ReservasjonStatus @default(aktiv)
  tilDato    DateTime?         @map("til_dato")
  opprettet  DateTime          @default(now())

  bedrift  Bedrift   @relation(fields: [bedriftId], references: [id])
  variant  Variant   @relation(fields: [variantId], references: [id])
  lokasjon Lokasjon  @relation(fields: [lokasjonId], references: [id])
  kontekst Kontekst? @relation(fields: [kontekstId], references: [id])
  formaal  Formaal?  @relation(fields: [formaalId], references: [id])
  bruker   Bruker    @relation(fields: [brukerId], references: [id])

  @@index([variantId, lokasjonId, status])
  @@index([bedriftId])
  @@map("reservasjoner")
}
